---
import Analytics from '../components/Analytics.astro'

export interface Props {
  title: string
  description?: string
}

const { title, description = '一个个人站' } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="google-adsense-account" content="ca-pub-XXXXXXXXXXXXXX" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Analytics />
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background-color: #eeeeee;
        margin-top: 0;
        margin-bottom: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', sans-serif;
        line-height: 1.7;
        color: #333;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a { color: #2aabff; text-decoration: none; }
      a:hover { color: #005d99; text-decoration: underline; }

      /* ── 卡片系统（来自原版 webtech/drapl.cn） ── */
      .block {
        box-sizing: border-box;
        box-shadow: 0 4px 5px 0 rgba(0,0,0,.14),
                    0 1px 10px 0 rgba(0,0,0,.12),
                    0 2px 4px -1px rgba(0,0,0,.2);
        background-color: white;
      }
      .sticker {
        width: 800px;
        padding: 10px 56px;
        margin-left: auto;
        margin-right: auto;
        margin-top: 20px;
      }
      .article {
        width: 800px;
        padding: 40px 56px;
        margin-left: auto;
        margin-right: auto;
        margin-bottom: 20px;
      }

      /* ── 导航 ── */
      .header {
        width: 800px;
        height: 55px;
        padding: 10px 10px;
        margin: 0 auto 20px auto;
        font-family: Georgia, 'Times New Roman', serif;
        text-transform: uppercase;
        font-weight: bold;
        font-size: 140%;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .header a {
        color: #000;
      }
      .header a:hover {
        color: #2aabff;
        text-decoration: none;
      }
      .header ul {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        gap: 2rem;
      }
      .header li {
        display: inline;
      }

      /* ── 内容区 ── */
      .main-wrap {
        flex: 1;
      }
      h1, h2, h3 { line-height: 1.3; margin: 1.5rem 0 0.5rem; }
      h1:first-child, h2:first-child { margin-top: 0; }
      p, li { margin-bottom: 0.8rem; }
      code {
        background: #f0f0f0;
        padding: 0.15rem 0.35rem;
        border-radius: 3px;
        font-size: 0.9em;
      }
      img { max-width: 100%; height: auto; border-radius: 4px; }
      blockquote {
        border-left: 3px solid #ddd;
        margin: 1rem 0;
        padding: 0.5rem 1rem;
        color: #666;
      }

      /* ── 页脚（原版风格） ── */
      footer {
        width: 800px;
        margin: 20px auto 0 auto;
        padding: 10px 0;
        color: grey;
        text-align: center;
        font-size: 75%;
      }
      footer a { color: grey; }
      footer a:hover { color: #2aabff; }

      /* ── 广告容器 ── */
      .ad-container {
        margin: 1.5rem 0;
        text-align: center;
        min-height: 0;
        overflow: hidden;
      }
      .ad-container ins {
        display: inline-block;
      }

      /* ── 暗色模式 ── */
      @media (prefers-color-scheme: dark) {
        body { background: #1a1a1a; color: #e0e0e0; }
        .block { background-color: #2a2a2a; }
        a { color: #60a5fa; }
        a:hover { color: #93c5fd; }
        .header a { color: #e0e0e0; }
        .header a:hover { color: #60a5fa; }
        code { background: #333; }
        blockquote { border-left-color: #555; color: #aaa; }
        footer { color: #777; }
        footer a { color: #777; }
        footer a:hover { color: #60a5fa; }
        .affiliate-link { background: #2a2a2a; border-color: #444; color: #ddd; }
        .affiliate-link:hover { background: #333; }
      }

      @media (max-width: 840px) {
        .sticker, .article, .header, footer {
          width: 100%;
        }
        .sticker, .article {
          padding: 20px;
        }
      }
    </style>
  </head>
  <body>
    <nav class="header block">
      <ul>
        <li><a href="/">⌂ 首页</a></li>
        <li><a href="/blog">📄 文章</a></li>
        <li><a href="/about">👤 关于</a></li>
        <li><a href="/privacy">🔒 隐私</a></li>
      </ul>
    </nav>

    <div class="main-wrap">
      <slot />
    </div>

    <footer class="block">
      <p>© {new Date().getFullYear()} <a href="/privacy">Chen Yufei</a></p>
      <p style="margin-top:4px;">Designed & coded by draplater</p>
      <p style="margin-top:6px;font-size:75%;color:#bbb;"><a href="/webtech" style="color:#bbb;">WST 2015</a></p>
    </footer>
  </body>
</html>
