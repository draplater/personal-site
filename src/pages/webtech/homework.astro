import BaseLayout from '../../layouts/BaseLayout.astro'

const sqlCode = `SELECT guest.Name 
FROM guest, party, participate ON participate
    LEFT JOIN party ON participate.Party_ID = party.Party_ID
    LEFT JOIN guest ON participate.Guest_ID = guest.guest_ID
WHERE party.Place = 'Peking University';`

const phpCode = `$row = mysql_fetch_array($result);
$keys = array_keys($row);
foreach ($keys as $key) { print key; }`

const phpCode2 = `$conn = mysqli_connect(...);
$conn->prepare(...);
mysqli_insert_id($conn);
$conn->real_escape_string(...);`

const tomcatCode = `cd ~
cp /home/2015/y2015g133/apache-tomcat-8.0.28.tar.gz ~
tar zxvf apache-tomcat-8.0.28.tar.gz
mv apache-tomcat-8.0.28 tomcat

# 配置 server.xml，改 8080 端口
tomcat/bin/startup.sh

# httpd.conf 开 mod_proxy mod_proxy_ajp
# 加 ProxyPass /tomcat ajp://localhost:$AJP_PORT`
